---
import Section from "../Section.astro";
import { formatEducationPeriod, hasEducationStarted } from "@/lib/education";

import { education } from "@cv";
---

<Section className={Astro.props.className} title="Education">
  <ul class="space-y-4 py-3 print:space-y-0">
    {
      education.map(
        ({
          institution,
          startDate,
          endDate,
          area,
          studyType,
          location,
          url,
        }) => {
          const period = formatEducationPeriod(startDate, endDate);
          const details = [studyType, location].filter(Boolean).join(" · ");
          const started = hasEducationStarted(startDate);

          return (
            <li class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-0 mt-1 hidden h-5 w-5 shrink-0 md:inline-block print:hidden"
                aria-hidden="true"
              >
                <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
                <path d="M22 10v6" />
                <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
              </svg>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="min-w-0 font-medium">
                    <a
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-[6px] decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
                      href={url}
                    >
                      {institution}
                    </a>
                  </h3>
                  <time
                    datetime={startDate}
                    data-start={startDate}
                    data-end={endDate ?? ""}
                    class:list={[
                      "education-period shrink-0 text-xs",
                      started ? "text-skin-muted" : "text-skin-hue",
                    ]}
                  >
                    {period}
                  </time>
                </div>
                <div class="text-sm text-skin-muted">
                  {area}
                  {details && (
                    <span class="block text-xs text-skin-muted/80">
                      {details}
                    </span>
                  )}
                </div>
              </div>
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<script>
  import { formatEducationPeriod, hasEducationStarted } from "@/lib/education";

  function updateEducationPeriods() {
    const now = new Date();

    document
      .querySelectorAll<HTMLElement>(".education-period")
      .forEach((el) => {
        const startDate = el.dataset.start;
        if (!startDate) return;

        const endDate = el.dataset.end || null;
        const started = hasEducationStarted(startDate, now);

        el.textContent = formatEducationPeriod(startDate, endDate, now);
        el.classList.toggle("text-skin-hue", !started);
        el.classList.toggle("text-skin-muted", started);
      });
  }

  updateEducationPeriods();
</script>
