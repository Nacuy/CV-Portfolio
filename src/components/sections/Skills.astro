---
import Section from "../Section.astro";
import { skills } from "@cv";
import { getSkillIcon } from "@/lib/skillIcons";

const skillCategories = {
  Frontend: [
    "HTML",
    "CSS",
    "JavaScript",
    "TypeScript",
    "React",
    "Next.js",
    "Tailwind CSS",
  ],
  Mobile: ["Flutter", "Kotlin", "React Native", "Expo"],
  Backend: ["Node.js", "C#", "SQL", "MySQL", "Laravel"],
  "Tools & Design": [
    "Git",
    "GitHub",
    "GitLab",
    "Figma",
    "Xcode",
    "Android Studio",
    "Sentry",
    "AI",
    "XML",
  ],
};

const categorizedSkills = skills.reduce(
  (acc, skill) => {
    const category =
      Object.entries(skillCategories).find(([_, categorySkills]) =>
        categorySkills.includes(skill.name),
      )?.[0] || "Other";

    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(skill);
    return acc;
  },
  {} as Record<string, typeof skills>,
);
---

<Section className={Astro.props.className} title="Skills">
  <div class="flex flex-col gap-8">
    {
      Object.entries(categorizedSkills)
        .filter(([_, categorySkills]) => categorySkills.length > 0)
        .map(([category, categorySkills]) => (
          <div class="flex flex-col gap-3">
            <h4 class="text-sm font-semibold uppercase tracking-wide text-skin-muted">
              {category}
            </h4>
            <ul class="inline-flex flex-wrap gap-4 [&>li>svg]:size-5 [&>li>svg]:text-skin-hue [&>li]:text-sm">
              {categorySkills.map(({ name }) => {
                const Icon = getSkillIcon(name);

                return (
                  <li class="flex items-center gap-1 rounded-md border-skin-hue/30 bg-skin-hue/10 px-2 py-0.5 text-xs text-skin-hue transition-colors hover:bg-skin-hue/15 print:border-none print:bg-transparent print:p-0 print:text-zinc-800">
                    {Icon && <Icon />} <span>{name}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
    }
  </div>
</Section>
