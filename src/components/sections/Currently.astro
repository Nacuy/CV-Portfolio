---
import Section from "../Section.astro";
import { getSkillIcon } from "@/lib/skillIcons";

import { currently } from "@cv";
---

<Section className={Astro.props.className} title="Currently">
  <ul class="flex flex-col gap-4">
    {
      currently.map(({ title, description, skills }) => (
        <li class="flex flex-col gap-3 border-l-2 border-skin-hue pl-4">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="relative flex size-2 shrink-0">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-skin-hue opacity-75" />
              <span class="relative inline-flex size-2 rounded-full bg-skin-hue" />
            </span>
            <span class="font-medium text-skin-base">{title}</span>
            <span class="rounded-full border border-skin-hue/30 bg-skin-hue/10 px-2 py-0.5 text-xs text-skin-hue">
              In progress
            </span>
          </div>

          <p class="text-sm text-skin-muted">{description}</p>

          {skills && skills.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Technologies">
              {skills.map((skill) => {
                const Icon = getSkillIcon(skill);
                return (
                  <li class="flex items-center gap-1 rounded-md border border-skin-hue/30 bg-skin-hue/10 px-2 py-0.5 text-xs text-skin-hue">
                    {Icon && <Icon />}
                    <span>{skill}</span>
                  </li>
                );
              })}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Section>
