---
const { className, title } = Astro.props;
---

<section class:list={["flex flex-col gap-3 print:gap-0", className]}>
  {
    title && (
      <h3 class="relative flex w-full items-center gap-3 text-2xl font-semibold tracking-tight print:text-xl">
        {title}
      </h3>
    )
  }
  <slot />
</section>
